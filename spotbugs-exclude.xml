<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter xmlns="https://github.com/spotbugs/filter/3.0.0">
    <!--
        CSRF-защита неприменима к stateless REST API: сессий и cookie нет,
        токен передаётся в заголовке Authorization, который браузер
        не подставляет автоматически при cross-site запросах.
    -->
    <Match>
        <Class name="com.itmo.infobezitmo.config.SecurityConfig"/>
        <Bug pattern="SPRING_CSRF_PROTECTION_DISABLED"/>
    </Match>
    <!-- Информационный маркер "здесь есть endpoint", а не дефект. -->
    <Match>
        <Bug pattern="SPRING_ENDPOINT"/>
    </Match>
</FindBugsFilter>
