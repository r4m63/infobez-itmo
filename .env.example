# Скопируйте в .env и задайте собственные значения. .env в git не коммитится.
POSTGRES_DB=infobez
POSTGRES_USER=infobez
POSTGRES_PASSWORD=change-me-strong-password

DB_URL=jdbc:postgresql://localhost:5432/infobez
DB_USERNAME=infobez
DB_PASSWORD=change-me-strong-password

# Минимум 32 символа, например: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-secret-at-least-32-chars

# Только для профиля dev (создание демо-пользователей)
DEMO_ADMIN_PASSWORD=change-me-admin
DEMO_USER_PASSWORD=change-me-user
