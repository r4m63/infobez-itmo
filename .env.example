# Скопируйте в .env: cp .env.example .env  (файл .env в git не попадает)
# Секрет подписи JWT, минимум 32 символа. Сгенерировать: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-secret-at-least-32-characters
# Пароли демо-пользователей (создаются при старте, хранятся только как bcrypt-хеши)
DEMO_ADMIN_PASSWORD=admin-password
DEMO_USER_PASSWORD=user-password
